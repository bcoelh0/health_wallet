<div class="lab-result-import-form-container">
  <div class="lab-result-import-header">
    <%= link_to "← Back to Imports", lab_result_imports_path, class: "back-link" %>
    <h1>Upload Lab Results File</h1>
  </div>

  <% if @lab_result_import.errors.any? %>
    <div class="flash-alert">
      <ul>
        <% @lab_result_import.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @lab_result_import, url: lab_result_imports_path, multipart: true do |f| %>
    <div class="form-group">
      <%= f.file_field :file, class: "form-input" %>
    </div>

    <div class="form-actions">
      <%= link_to "Cancel", lab_result_imports_path, class: "btn btn-secondary" %>
      <%= f.submit "Upload", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
